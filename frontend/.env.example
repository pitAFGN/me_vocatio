# Copia este archivo a .env.local y ajusta los valores.

# URL del backend que usa el navegador del usuario (se embebe en el bundle en tiempo de build).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google reCAPTCHA (site key pública) para el registro.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Supabase (login con Google). Credenciales públicas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto HMAC con el que el BACKEND firma el access_token (JWT).
# Debe ser IDÉNTICO a JWT_ACCESS_SECRET del backend para que el middleware
# (src/proxy.js) pueda verificar la firma y proteger las rutas del lado servidor.
JWT_ACCESS_SECRET=

# URL del backend en producción (SOLO deploy, p. ej. https://tu-app.up.railway.app).
# next.config.mjs reescribe /api/* hacia este upstream; en desarrollo no hace
# falta (se usa el valor por defecto http://localhost:3001).
API_UPSTREAM_URL=