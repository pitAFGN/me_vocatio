DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DATABASE?sslmode=require
FRONTEND_URL=http://localhost:3000
GROQ_MODEL=openai/gpt-oss-120b
TRUST_PROXY=1
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT y sesión
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail API (envío de correos por HTTPS)
# GET client id y secret: https://console.cloud.google.com/
# Refresh token: OAuth Playground con redirect https://developers.google.com/oauthplayground
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Supabase (login con Google)
# Usadas para validar el token de Google que envía el frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google reCAPTCHA (registro)
RECAPTCHA_SECRET_KEY=

# IA (Groq)
# Clave de la API de Groq; toda la IA de tests, recomendaciones y análisis pasa por ahí.
GROQ_API_KEY=

# Pagos Wompi
# WOMPI_ENV: 'sandbox' mientras pruebas, 'production' cuando cobres de verdad.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Swagger: /api-docs se expone automáticamente fuera de producción.
# En producción solo se habilita si se fuerza con "true" (no recomendado).
SWAGGER_ENABLED=false