────────────────────

# Puerto del HOST donde se expondrá el backend (dentro del contenedor
# siempre escucha en 3001, definido por backend/src/server.js).
BACKEND_PORT=3001

# Puerto del HOST donde se expondrá el frontend (dentro del contenedor
# siempre escucha en 3000).
FRONTEND_PORT=3000

# URL pública del backend, tal como la usará el NAVEGADOR del usuario.
# Si vas a desplegar en un dominio real, cambia esto por ese dominio
# (ej. https://api.mevocatio.com) y reconstruye la imagen del frontend,
# ya que esta variable se embebe en tiempo de build.
NEXT_PUBLIC_API_URL=http://localhost:3001